// Reusable Top Navigation Bar with Back & Home icon
function TopNavBar({
  title,
  lang,
  onBack,
  onHome,
  onToggleLang,
}: {
  title: string;
  lang: SupportedLanguage;
  onBack?: () => void;
  onHome?: () => void;
  onToggleLang: () => void;
}) {
  return (
    <header className="w-full flex items-center justify-between py-2 select-none">
      <div className="w-10">
        {onBack && (
          <button
            type="button"
            onClick={onBack}
            aria-label="Go back"
            className="w-10 h-10 flex items-center justify-center -ml-2 rounded-full hover:bg-black/5 active:scale-95 transition-all text-[#474747]"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <line x1="19" y1="12" x2="5" y2="12" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
          </button>
        )}
      </div>

      <h2
        className="text-[15px] font-semibold tracking-tight text-center truncate px-2 text-[#474747]"
        style={{ fontFamily: DESIGN_TOKENS.typography.sans }}
      >
        {title}
      </h2>

      <div className="flex items-center gap-1.5">
        <button
          type="button"
          onClick={onToggleLang}
          aria-label="Toggle language"
          className="min-w-[38px] h-[30px] px-2.5 rounded-full bg-white border border-[#E9DFD3] text-[11px] font-semibold tracking-wider flex items-center justify-center shadow-2xs hover:border-[#DE8B87] active:scale-95 transition-all uppercase text-[#474747]"
          style={{ fontFamily: DESIGN_TOKENS.typography.sans }}
        >
          {lang === 'en' ? 'RU' : 'EN'}
        </button>

        {onHome && (
          <button
            type="button"
            onClick={onHome}
            aria-label="Go to Home"
            className="w-8 h-8 rounded-full flex items-center justify-center text-[#DE8B87] hover:bg-black/5 active:scale-90 transition-all"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            </svg>
          </button>
        )}
      </div>
    </header>
  );
}

// Reusable Button
function Button({
  variant = 'primary',
  children,
  className = '',
  onClick,
}: {
  variant?: 'primary' | 'secondary';
  children: React.ReactNode;
  className?: string;
  onClick?: () => void;
}) {
  const isPrimary = variant === 'primary';
  return (
    <button
      type="button"
      onClick={onClick}
      className={`w-full min-h-[50px] px-6 py-3 rounded-[20px] text-[15px] font-medium transition-all duration-200 outline-none flex items-center justify-center text-center shadow-sm active:scale-[0.98] ${className}`}
      style={{
        backgroundColor: isPrimary ? DESIGN_TOKENS.colors.primaryButton : DESIGN_TOKENS.colors.white,
        color: isPrimary ? DESIGN_TOKENS.colors.white : DESIGN_TOKENS.colors.text,
        fontFamily: DESIGN_TOKENS.typography.sans,
      }}
    >
      {children}
    </button>
  );
}

// Reusable Input
function Input({
  label,
  value,
  onChange,
  type = 'text',
}: {
  label: string;
  value: string;
  onChange: (e: React.ChangeEvent<HTMLInputElement>) => void;
  type?: string;
}) {
  return (
    <div className="w-full p-0.5">
      <input
        type={type}
        aria-label={label}
        placeholder={label}
        value={value}
        onChange={onChange}
        className="w-full min-h-[52px] px-5 py-3 rounded-[20px] bg-white text-center text-[15px] transition-all outline-none border border-transparent shadow-xs placeholder:text-[#7A7A7A] focus:border-[#DE8B87]"
        style={{
          color: DESIGN_TOKENS.colors.text,
          fontFamily: DESIGN_TOKENS.typography.sans,
        }}
      />
    </div>
  );
}

// Themed Popup Dialog
function ThemedPopup({
  isOpen,
  isError,
  title,
  message,
  primaryButtonText,
  onPrimaryClick,
  secondaryButtonText,
  onSecondaryClick,
}: {
  isOpen: boolean;
  isError: boolean;
  title?: string;
  message: string;
  primaryButtonText: string;
  onPrimaryClick: () => void;
  secondaryButtonText?: string;
  onSecondaryClick?: () => void;
}) {
  if (!isOpen) return null;

  return (
    <div
      role="alertdialog"
      aria-modal="true"
      className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/45 backdrop-blur-xs"
    >
      <div
        className="w-full max-w-[340px] rounded-[32px] p-6 shadow-2xl space-y-4 text-center border border-[#ECE2D2]"
        style={{ backgroundColor: DESIGN_TOKENS.colors.background }}
      >
        <div
          className="w-12 h-12 rounded-full mx-auto flex items-center justify-center text-xl font-bold"
          style={{
            backgroundColor: DESIGN_TOKENS.colors.softPinkCard,
            color: isError ? DESIGN_TOKENS.colors.errorRed : DESIGN_TOKENS.colors.accent,
          }}
        >
          {isError ? '!' : '♡'}
        </div>

        <div className="space-y-1.5">
          {title && (
            <h3
              className="text-[20px] font-bold tracking-tight"
              style={{
                fontFamily: DESIGN_TOKENS.typography.serif,
                color: DESIGN_TOKENS.colors.text,
              }}
            >
              {title}
            </h3>
          )}
          <p
            className="text-[14px] leading-relaxed opacity-90"
            style={{
              fontFamily: DESIGN_TOKENS.typography.sans,
              color: DESIGN_TOKENS.colors.text,
            }}
          >
            {message}
          </p>
        </div>

        <div className="space-y-2.5 pt-2">
          <Button variant="primary" onClick={onPrimaryClick}>
            {primaryButtonText}
          </Button>

          {secondaryButtonText && onSecondaryClick && (
            <Button variant="secondary" onClick={onSecondaryClick}>
              {secondaryButtonText}
            </Button>
          )}
        </div>
      </div>
    </div>
  );
}

