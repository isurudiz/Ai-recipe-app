  const [currentScreen, setCurrentScreen] = useState<Screen>('welcome');
  const [lang, setLang] = useState<SupportedLanguage>('en');
  const [activeTab, setActiveTab] = useState<TabType>('home');

  // Input states
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [resetToken, setResetToken] = useState('expired');

  // Allergies screen state
  const [selectedAllergens, setSelectedAllergens] = useState<string[]>(['dairy']);
  const [customIngredient, setCustomIngredient] = useState('');

  // What to cook screen state
  const [inputMode, setInputMode] = useState<'photo' | 'type' | 'voice'>('photo');
  const [wtcQuickPrefs, setWtcQuickPrefs] = useState<string[]>(['protein']);

  // Fit my macros state
  const [macroChoice, setMacroChoice] = useState<'yes' | 'no'>('yes');

  // Dessert screen state
  const [dessertTags, setDessertTags] = useState<string[]>(['chocolate', 'sugarFree', 'highProtein']);

  // Surprise me state
  const [moodIndex, setMoodIndex] = useState<number>(0);

  // Everyday meals state
  const [mealType, setMealType] = useState<string>('dinner');
  const [selectedFilters, setSelectedFilters] = useState<string[]>(['balanced']);

  // Popup Dialog State
  const [popup, setPopup] = useState<{
    isOpen: boolean;
    isError: boolean;
    title?: string;
    message: string;
    primaryBtn: string;
    onPrimary: () => void;
    secondaryBtn?: string;
    onSecondary?: () => void;
  }>({
    isOpen: false,
    isError: false,
    message: '',
    primaryBtn: '',
    onPrimary: () => {},
  });

  const t = translations[lang];

  const navigateTo = (newScreen: Screen) => {
    setCurrentScreen(newScreen);
  };

  const toggleLanguage = () => {
    setLang((prev) => (prev === 'en' ? 'ru' : 'en'));
  };

  const handleLanguageSelect = (selectedLang: SupportedLanguage) => {
    setLang(selectedLang);
    navigateTo('signup');
  };

  const closePopup = () => {
    setPopup((prev) => ({ ...prev, isOpen: false }));
  };

  const isValidEmail = (val: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val.trim());

  // Sign Up
  const handleSignUp = () => {
    if (!isValidEmail(email)) {
      setPopup({
        isOpen: true,
        isError: true,
        title: t.errors.noticeTitle,
        message: t.errors.invalidEmail,
        primaryBtn: t.errors.okBtn,
        onPrimary: closePopup,
      });
      return;
    }

    if (email.trim().toLowerCase() === MOCK_EXISTING_USER.email) {
      setPopup({
        isOpen: true,
        isError: true,
        title: t.errors.noticeTitle,
        message: t.errors.emailRegistered,
        primaryBtn: t.errors.signInAction,
        onPrimary: () => {
          closePopup();
          navigateTo('signin');
        },
        secondaryBtn: t.errors.okBtn,
        onSecondary: closePopup,
      });
      return;
    }

    if (password.length < 8) {
      setPopup({
        isOpen: true,
        isError: true,
        title: t.errors.noticeTitle,
        message: t.errors.shortPassword,
        primaryBtn: t.errors.okBtn,
        onPrimary: closePopup,
      });
      return;
    }

    navigateTo('allergies');
  };

  // Sign In
  const handleSignIn = () => {
    if (!isValidEmail(email)) {
      setPopup({
        isOpen: true,
        isError: true,
        title: t.errors.noticeTitle,
        message: t.errors.invalidEmail,
        primaryBtn: t.errors.okBtn,
        onPrimary: closePopup,
      });
      return;
    }

    if (password.length < 8) {
      setPopup({
        isOpen: true,
        isError: true,
        title: t.errors.noticeTitle,
        message: t.errors.shortPassword,
        primaryBtn: t.errors.okBtn,
        onPrimary: closePopup,
      });
      return;
    }

    if (
      email.trim().toLowerCase() !== MOCK_EXISTING_USER.email ||
      password !== MOCK_EXISTING_USER.password
    ) {
      setPopup({
        isOpen: true,
        isError: true,
        title: t.errors.noticeTitle,
        message: t.errors.wrongLogin,
        primaryBtn: t.errors.okBtn,
        onPrimary: closePopup,
      });
      return;
    }

    navigateTo('today');
  };

  // Password Reset
  const handleVerifyResetLink = () => {
    if (resetToken.trim().toLowerCase() === 'expired') {
      setPopup({
        isOpen: true,
        isError: true,
        title: t.errors.noticeTitle,
        message: t.errors.expiredReset,
        primaryBtn: t.errors.sendNewLinkAction,
        onPrimary: () => {
          setPopup({
            isOpen: true,
            isError: false,
            title: t.modal.linkSentTitle,
            message: t.modal.linkSentDesc,
            primaryBtn: t.errors.okBtn,
            onPrimary: closePopup,
          });
        },
        secondaryBtn: t.errors.okBtn,
        onSecondary: closePopup,
      });
      return;
    }

    navigateTo('signin');
  };

  const toggleAllergen = (key: string) => {
    setSelectedAllergens((prev) =>
      prev.includes(key) ? prev.filter((item) => item !== key) : [...prev, key]
    );
  };

  const handleSavePreferences = () => {
    const hasNoAllergies = selectedAllergens.length === 0 && customIngredient.trim() === '';

    if (hasNoAllergies) {
      setPopup({
        isOpen: true,
        isError: false,
        message: t.allergies.noAllergiesPrompt,
        primaryBtn: t.allergies.yesNoneBtn,
        onPrimary: () => {
          closePopup();
          navigateTo('today');
        },
        secondaryBtn: t.allergies.goBackBtn,
        onSecondary: closePopup,
      });
      return;
    }

    navigateTo('today');
  };

  const allergenList = [
    { key: 'dairy', label: t.allergies.tags.dairy },
    { key: 'gluten', label: t.allergies.tags.gluten },
    { key: 'nuts', label: t.allergies.tags.nuts },
    { key: 'eggs', label: t.allergies.tags.eggs },
    { key: 'soy', label: t.allergies.tags.soy },
    { key: 'fish', label: t.allergies.tags.fish },
  ];

  const toggleWtcPref = (key: string) => {
    setWtcQuickPrefs((prev) =>
      prev.includes(key) ? prev.filter((k) => k !== key) : [...prev, key]
    );
  };

  const toggleDessertTag = (key: string) => {
    setDessertTags((prev) =>
      prev.includes(key) ? prev.filter((k) => k !== key) : [...prev, key]
    );
  };

  const toggleMealFilter = (key: string) => {
    setSelectedFilters((prev) =>
      prev.includes(key) ? prev.filter((k) => k !== key) : [...prev, key]
    );
  };

  return (
    <div
      className="min-h-screen w-full flex justify-center items-center px-4 py-4"
      style={{
        backgroundColor: DESIGN_TOKENS.colors.background,
        color: DESIGN_TOKENS.colors.text,
        fontFamily: DESIGN_TOKENS.typography.sans,
      }}
    >
      <main className="w-full max-w-[390px] min-h-[760px] flex flex-col justify-between mx-auto overflow-visible">

        {/* SCREEN 1: WELCOME */}
        {currentScreen === 'welcome' && (
          <div key="welcome" className="flex-1 flex flex-col justify-between">
            <header className="pt-2 pb-2 text-center">
              <p
                className="text-[14px] font-medium tracking-wide"
                style={{
                  color: DESIGN_TOKENS.colors.accent,
                  fontFamily: DESIGN_TOKENS.typography.sans,
                }}
              >
                {t.welcome.topHeader}
              </p>
            </header>

            <section className="flex-1 flex flex-col justify-center my-auto space-y-6">
              <div className="relative w-full aspect-[1/0.92] rounded-[32px] overflow-hidden shadow-xs">
                <img
                  src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80"
                  alt={t.welcome.imageAlt}
                  className="w-full h-full object-cover"
                />
                <span className="absolute bottom-3 right-3 bg-black/45 backdrop-blur-xs text-white text-[11px] font-medium px-2.5 py-1 rounded-full tracking-wider">
                  {t.welcome.badge}
                </span>
              </div>

              <div className="space-y-3 px-1">
                <h1
                  className="text-[38px] leading-[1.12] font-bold tracking-tight whitespace-pre-line"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.serif,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.welcome.headline}
                </h1>
                <p
                  className="text-[15px] leading-relaxed whitespace-pre-line opacity-85"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.sans,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.welcome.subtitle}
                </p>
              </div>
            </section>

            <footer className="pt-4 pb-2">
              <div className="grid grid-cols-2 gap-3.5">
                <Button
                  variant="secondary"
                  onClick={() => handleLanguageSelect('ru')}
                >
                  {t.welcome.russianBtn}
                </Button>
                <Button
                  variant="primary"
                  onClick={() => handleLanguageSelect('en')}
                >
                  {t.welcome.englishBtn}
                </Button>
              </div>
            </footer>
          </div>
        )}

        {/* SCREEN 2: SIGN UP */}
        {currentScreen === 'signup' && (
          <div key="signup" className="flex-1 flex flex-col justify-start">
            <TopNavBar
              title={t.nav.signupTitle}
              lang={lang}
              onBack={() => navigateTo('welcome')}
              onToggleLang={toggleLanguage}
            />

            <div className="space-y-6 pt-4">
              <div className="space-y-2">
                <h1
                  className="text-[36px] leading-[1.15] font-bold tracking-tight"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.serif,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.signup.title}
                </h1>
                <p
                  className="text-[14px] leading-snug"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.sans,
                    color: DESIGN_TOKENS.colors.textMuted,
                  }}
                >
                  {t.signup.subtitle}
                </p>
              </div>

              <div className="space-y-3.5 pt-1">
                <Input
                  label={t.signup.emailPlaceholder}
                  type="text"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                />

                <Input
                  label={t.signup.passwordPlaceholder}
                  type="password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                />

                <div className="pt-2">
                  <Button variant="primary" onClick={handleSignUp}>
                    {t.signup.submitBtn}
                  </Button>
                </div>

                <div className="text-center pt-2">
                  <button
                    type="button"
                    onClick={() => {
                      setEmail('');
                      setPassword('');
                      navigateTo('signin');
                    }}
                    className="text-[13.5px] transition-opacity hover:opacity-80"
                    style={{
                      color: DESIGN_TOKENS.colors.textMuted,
                      fontFamily: DESIGN_TOKENS.typography.sans,
                    }}
                  >
                    {t.signup.alreadyRegistered}
                  </button>
                </div>
              </div>

              <p className="text-[11.5px] text-center text-[#474747]/50 italic">
                {t.signup.demoHint}
              </p>
            </div>
          </div>
        )}

        {/* SCREEN 3: SIGN IN */}
        {currentScreen === 'signin' && (
          <div key="signin" className="flex-1 flex flex-col justify-start">
            <TopNavBar
              title={t.nav.signinTitle}
              lang={lang}
              onBack={() => navigateTo('signup')}
              onToggleLang={toggleLanguage}
            />

            <div className="space-y-6 pt-4">
              <div className="space-y-2">
                <h1
                  className="text-[36px] leading-[1.15] font-bold tracking-tight"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.serif,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.signin.title}
                </h1>
                <p
                  className="text-[14px] leading-snug"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.sans,
                    color: DESIGN_TOKENS.colors.textMuted,
                  }}
                >
                  {t.signin.subtitle}
                </p>
              </div>

              <div className="space-y-3.5 pt-1">
                <Input
                  label={t.signin.emailPlaceholder}
                  type="text"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                />

                <Input
                  label={t.signin.passwordPlaceholder}
                  type="password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                />

                <div className="pt-2">
                  <Button variant="primary" onClick={handleSignIn}>
                    {t.signin.submitBtn}
                  </Button>
                </div>

                <div className="flex flex-col items-center gap-2 pt-2">
                  <button
                    type="button"
                    onClick={() => {
                      setEmail('');
                      setPassword('');
                      navigateTo('signup');
                    }}
                    className="text-[13.5px] transition-opacity hover:opacity-80"
                    style={{
                      color: DESIGN_TOKENS.colors.textMuted,
                      fontFamily: DESIGN_TOKENS.typography.sans,
                    }}
                  >
                    {t.signin.noAccount}
                  </button>

                  <button
                    type="button"
                    onClick={() => navigateTo('forgot')}
                    className="text-[12.5px] underline transition-opacity hover:opacity-80"
                    style={{
                      color: DESIGN_TOKENS.colors.accent,
                      fontFamily: DESIGN_TOKENS.typography.sans,
                    }}
                  >
                    {t.signin.forgotPasswordLink}
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* SCREEN 4: PASSWORD RESET */}
        {currentScreen === 'forgot' && (
          <div key="forgot" className="flex-1 flex flex-col justify-start">
            <TopNavBar
              title={t.nav.forgotTitle}
              lang={lang}
              onBack={() => navigateTo('signin')}
              onToggleLang={toggleLanguage}
            />

            <div className="space-y-6 pt-4">
              <div className="space-y-2">
                <h1
                  className="text-[34px] leading-[1.15] font-bold tracking-tight"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.serif,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.forgot.title}
                </h1>
                <p
                  className="text-[14px] leading-snug"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.sans,
                    color: DESIGN_TOKENS.colors.textMuted,
                  }}
                >
                  {t.forgot.subtitle}
                </p>
              </div>

              <div className="space-y-4 pt-1">
                <Input
                  label={t.forgot.linkInputPlaceholder}
                  type="text"
                  value={resetToken}
                  onChange={(e) => setResetToken(e.target.value)}
                />

                <div className="pt-2">
                  <Button variant="primary" onClick={handleVerifyResetLink}>
                    {t.forgot.verifyBtn}
                  </Button>
                </div>

                <p className="text-[12px] text-center text-[#474747]/60 italic pt-2">
                  {t.forgot.testExpiredHint}
                </p>
              </div>
            </div>
          </div>
        )}

        {/* SCREEN 5: ALLERGIES & EXCLUSIONS */}
        {currentScreen === 'allergies' && (
          <div key="allergies" className="flex-1 flex flex-col justify-between">
            <div className="w-full text-left">
              <TopNavBar
                title={t.nav.allergiesTitle}
                lang={lang}
                onBack={() => navigateTo('signup')}
                onToggleLang={toggleLanguage}
              />

              <div className="pt-3 space-y-2 text-left">
                <h1
                  className="text-[34px] font-bold leading-[1.12] tracking-tight whitespace-pre-line text-left"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.sans,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.allergies.headline}
                </h1>
                <p
                  className="text-[13.5px] leading-relaxed text-left"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.sans,
                    color: DESIGN_TOKENS.colors.textMuted,
                  }}
                >
                  {t.allergies.subtitle}
                </p>
              </div>

              {/* Tag selector */}
              <div className="pt-6 flex flex-wrap gap-2.5 justify-start">
                {allergenList.map(({ key, label }) => {
                  const isSelected = selectedAllergens.includes(key);
                  return (
                    <button
                      key={key}
                      type="button"
                      onClick={() => toggleAllergen(key)}
                      className={`min-h-[40px] px-4 py-2 rounded-full text-[13px] font-medium transition-all duration-150 active:scale-95 outline-none ${
                        isSelected
                          ? 'border border-[#E58B91] shadow-xs'
                          : 'border border-[#E8DFC9] bg-white hover:bg-[#FAF6F0]'
                      }`}
                      style={{
                        backgroundColor: isSelected
                          ? DESIGN_TOKENS.colors.softPinkCard
                          : DESIGN_TOKENS.colors.white,
                        color: DESIGN_TOKENS.colors.text,
                      }}
                    >
                      {label}
                    </button>
                  );
                })}
              </div>

              {/* Custom Ingredient */}
              <div className="pt-6">
                <div className="w-full bg-white rounded-[24px] p-4 border border-[#ECE2D2] shadow-xs text-left">
                  <label
                    htmlFor="custom-ingredient"
                    className="block text-[12.5px] font-semibold tracking-tight text-[#474747] text-left"
                  >
                    {t.allergies.customLabel}
                  </label>
                  <input
                    id="custom-ingredient"
                    type="text"
                    value={customIngredient}
                    onChange={(e) => setCustomIngredient(e.target.value)}
                    placeholder={t.allergies.customPlaceholder}
                    className="w-full bg-transparent outline-none text-[13.5px] text-[#474747] placeholder:text-[#A0A0A0] mt-1 text-left"
                  />
                </div>
              </div>

              {/* Sage Panel */}
              <div className="pt-4">
                <div
                  className="w-full rounded-[24px] p-4 space-y-1 text-left"
                  style={{ backgroundColor: DESIGN_TOKENS.colors.sagePanel }}
                >
                  <h3
                    className="text-[13px] font-semibold text-left"
                    style={{ color: DESIGN_TOKENS.colors.sageTextTitle }}
                  >
                    {t.allergies.sageTitle}
                  </h3>
                  <p
                    className="text-[12.5px] leading-snug text-left"
                    style={{ color: DESIGN_TOKENS.colors.sageTextBody }}
                  >
                    {t.allergies.sageDescription}
                  </p>
                </div>
              </div>
            </div>

            <footer className="pt-6 pb-2">
              <Button variant="primary" onClick={handleSavePreferences}>
                {t.allergies.saveBtn}
              </Button>
            </footer>
          </div>
        )}

        {/* SCREEN 6: TODAY DASHBOARD */}
        {currentScreen === 'today' && (
          <div key="today" className="flex-1 flex flex-col justify-between">
            <TopNavBar
              title={t.nav.todayTitle}
              lang={lang}
              onToggleLang={toggleLanguage}
            />

            <div className="flex-1 overflow-y-auto space-y-5 pb-6 text-left">
              <div className="space-y-1 pt-1">
                <span
                  className="text-[14px] font-medium block"
                  style={{ color: DESIGN_TOKENS.colors.accent }}
                >
                  {t.today.greeting}
                </span>
                <h1
                  className="text-[34px] leading-[1.12] font-bold tracking-tight"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.serif,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.today.headline}
                </h1>
                <p
                  className="text-[13.5px] opacity-75"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.sans,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.today.subheadline}
                </p>
              </div>

              {/* Category Grid */}
              <div className="grid grid-cols-2 gap-3.5">
                {/* 1. What to cook */}
                <div
                  onClick={() => navigateTo('whatToCook')}
                  className="rounded-[28px] p-3 flex flex-col justify-between shadow-xs transition-transform active:scale-[0.98] cursor-pointer"
                  style={{ backgroundColor: DESIGN_TOKENS.colors.sagePanel }}
                >
                  <div className="w-full aspect-[4/3] rounded-[20px] overflow-hidden mb-2.5 shadow-2xs">
                    <img
                      src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=500&q=80"
                      alt="Grain bowl"
                      className="w-full h-full object-cover"
                    />
                  </div>
                  <div>
                    <h3
                      className="text-[15px] font-bold tracking-tight leading-tight"
                      style={{
                        fontFamily: DESIGN_TOKENS.typography.serif,
                        color: DESIGN_TOKENS.colors.text,
                      }}
                    >
                      {t.today.cards.whatToCook}
                    </h3>
                    <p className="text-[11px] text-[#474747]/70 leading-snug mt-1">
                      {t.today.cards.whatToCookDesc}
                    </p>
                  </div>
                </div>

                {/* 2. Fit my macros */}
                <div
                  onClick={() => navigateTo('fitMacros')}
                  className="rounded-[28px] p-3 flex flex-col justify-between shadow-xs transition-transform active:scale-[0.98] cursor-pointer"
                  style={{ backgroundColor: DESIGN_TOKENS.colors.softPinkCard }}
                >
                  <div className="w-full aspect-[4/3] rounded-[20px] overflow-hidden mb-2.5 shadow-2xs">
                    <img
                      src="https://images.unsplash.com/photo-1621996346565-e3d5d6281206?auto=format&fit=crop&w=500&q=80"
                      alt="Pasta dish"
                      className="w-full h-full object-cover"
                    />
                  </div>
                  <div>
                    <h3
                      className="text-[15px] font-bold tracking-tight leading-tight"
                      style={{
                        fontFamily: DESIGN_TOKENS.typography.serif,
                        color: DESIGN_TOKENS.colors.text,
                      }}
                    >
                      {t.today.cards.fitMacros}
                    </h3>
                    <p className="text-[11px] text-[#474747]/70 leading-snug mt-1">
                      {t.today.cards.fitMacrosDesc}
                    </p>
                  </div>
                </div>

                {/* 3. I want dessert */}
                <div
                  onClick={() => navigateTo('dessert')}
                  className="rounded-[28px] p-3 flex flex-col justify-between shadow-xs transition-transform active:scale-[0.98] cursor-pointer"
                  style={{ backgroundColor: DESIGN_TOKENS.colors.softPinkCard }}
                >
                  <div className="w-full aspect-[4/3] rounded-[20px] overflow-hidden mb-2.5 shadow-2xs">
                    <img
                      src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=500&q=80"
                      alt="Chocolate cake"
                      className="w-full h-full object-cover"
                    />
                  </div>
                  <div>
                    <h3
                      className="text-[15px] font-bold tracking-tight leading-tight"
                      style={{
                        fontFamily: DESIGN_TOKENS.typography.serif,
                        color: DESIGN_TOKENS.colors.text,
                      }}
                    >
                      {t.today.cards.dessert}
                    </h3>
                    <p className="text-[11px] text-[#474747]/70 leading-snug mt-1">
                      {t.today.cards.dessertDesc}
                    </p>
                  </div>
                </div>

                {/* 4. Surprise me */}
                <div
                  onClick={() => navigateTo('surprise')}
                  className="rounded-[28px] p-3 flex flex-col justify-between shadow-xs transition-transform active:scale-[0.98] cursor-pointer"
                  style={{ backgroundColor: DESIGN_TOKENS.colors.beigeCard }}
                >
                  <div className="w-full aspect-[4/3] rounded-[20px] overflow-hidden mb-2.5 shadow-2xs">
                    <img
                      src="https://images.unsplash.com/photo-1543339308-43e59d6b73a6?auto=format&fit=crop&w=500&q=80"
                      alt="Rice bowl with veggies"
                      className="w-full h-full object-cover"
                    />
                  </div>
                  <div>
                    <h3
                      className="text-[15px] font-bold tracking-tight leading-tight"
                      style={{
                        fontFamily: DESIGN_TOKENS.typography.serif,
                        color: DESIGN_TOKENS.colors.text,
                      }}
                    >
                      {t.today.cards.surprise}
                    </h3>
                    <p className="text-[11px] text-[#474747]/70 leading-snug mt-1">
                      {t.today.cards.surpriseDesc}
                    </p>
                  </div>
                </div>
              </div>

              {/* Wide Banner: Everyday meals */}
              <div
                onClick={() => navigateTo('everydayMeals')}
                className="rounded-[26px] p-4 flex items-center justify-between cursor-pointer transition-transform active:scale-[0.99] shadow-xs"
                style={{ backgroundColor: DESIGN_TOKENS.colors.sagePanel }}
              >
                <div className="space-y-0.5">
                  <h4
                    className="text-[15px] font-bold"
                    style={{ color: DESIGN_TOKENS.colors.text }}
                  >
                    {t.today.banner.title}
                  </h4>
                  <p className="text-[12px] text-[#474747]/75">
                    {t.today.banner.subtitle}
                  </p>
                </div>
                <div
                  className="w-8 h-8 rounded-full flex items-center justify-center text-lg"
                  style={{ color: DESIGN_TOKENS.colors.accent }}
                >
                  →
                </div>
              </div>

              {/* Bottom Quick Cards */}
              <div className="grid grid-cols-2 gap-3.5 pt-1">
                <div className="rounded-[24px] p-4 bg-white border border-[#EFE5D8] shadow-2xs cursor-pointer">
                  <h5 className="text-[13px] font-bold text-[#474747]">
                    {t.today.bottomCards.worthKnowing}
                  </h5>
                  <p className="text-[11px] text-[#474747]/70 mt-0.5">
                    {t.today.bottomCards.worthKnowingSub}
                  </p>
                </div>

                <div
                  className="rounded-[24px] p-4 shadow-2xs cursor-pointer"
                  style={{ backgroundColor: DESIGN_TOKENS.colors.softPinkCard }}
                >
                  <h5 className="text-[13px] font-bold text-[#474747]">
                    {t.today.bottomCards.proRecipes}
                  </h5>
                  <p className="text-[11px] text-[#474747]/70 mt-0.5">
                    {t.today.bottomCards.proRecipesSub}
                  </p>
                </div>
              </div>
            </div>

            {/* Bottom App Nav */}
            <nav className="w-full pt-3 pb-1 border-t border-[#EAE1D3] flex items-center justify-around select-none">
              <button
                type="button"
                onClick={() => setActiveTab('home')}
                className="flex flex-col items-center gap-1 transition-transform active:scale-90"
                style={{
                  color:
                    activeTab === 'home'
                      ? DESIGN_TOKENS.colors.primaryButton
                      : DESIGN_TOKENS.colors.textMuted,
                }}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                </svg>
                <span className="text-[11px] font-medium">{t.today.tabs.home}</span>
              </button>

              <button
                type="button"
                onClick={() => setActiveTab('favorites')}
                className="flex flex-col items-center gap-1 transition-transform active:scale-90"
                style={{
                  color:
                    activeTab === 'favorites'
                      ? DESIGN_TOKENS.colors.primaryButton
                      : DESIGN_TOKENS.colors.textMuted,
                }}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                </svg>
                <span className="text-[11px] font-medium">{t.today.tabs.favorites}</span>
              </button>

              <button
                type="button"
                onClick={() => setActiveTab('history')}
                className="flex flex-col items-center gap-1 transition-transform active:scale-90"
                style={{
                  color:
                    activeTab === 'history'
                      ? DESIGN_TOKENS.colors.primaryButton
                      : DESIGN_TOKENS.colors.textMuted,
                }}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                <span className="text-[11px] font-medium">{t.today.tabs.history}</span>
              </button>

              <button
                type="button"
                onClick={() => setActiveTab('me')}
                className="flex flex-col items-center gap-1 transition-transform active:scale-90"
                style={{
                  color:
                    activeTab === 'me'
                      ? DESIGN_TOKENS.colors.primaryButton
                      : DESIGN_TOKENS.colors.textMuted,
                }}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
                <span className="text-[11px] font-medium">{t.today.tabs.me}</span>
              </button>
            </nav>
          </div>
        )}

        {/* SCREEN 7: WHAT TO COOK */}
        {currentScreen === 'whatToCook' && (
          <div key="whatToCook" className="flex-1 flex flex-col justify-between">
            <div className="w-full text-left space-y-5">
              <TopNavBar
                title={t.nav.whatToCookTitle}
                lang={lang}
                onBack={() => navigateTo('today')}
                onHome={() => navigateTo('today')}
                onToggleLang={toggleLanguage}
              />

              <div className="space-y-1.5">
                <h1
                  className="text-[34px] font-bold leading-[1.12] tracking-tight"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.serif,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.whatToCook.headline}
                </h1>
                <p className="text-[13.5px] opacity-75 leading-relaxed">
                  {t.whatToCook.subtitle}
                </p>
              </div>

              {/* Mode Switcher Card */}
              <div className="bg-white rounded-[26px] p-3 shadow-xs border border-[#ECE2D2] space-y-3">
                <div className="grid grid-cols-3 gap-2">
                  {(['photo', 'type', 'voice'] as const).map((mode) => {
                    const isSelected = inputMode === mode;
                    return (
                      <button
                        key={mode}
                        type="button"
                        onClick={() => setInputMode(mode)}
                        className={`py-2 rounded-[16px] text-[13px] font-medium transition-all ${
                          isSelected
                            ? 'border border-[#E58B91]'
                            : 'bg-white border border-[#EFE5D8]'
                        }`}
                        style={{
                          backgroundColor: isSelected
                            ? DESIGN_TOKENS.colors.softPinkCard
                            : DESIGN_TOKENS.colors.white,
                          color: DESIGN_TOKENS.colors.text,
                        }}
                      >
                        {t.whatToCook.tabs[mode]}
                      </button>
                    );
                  })}
                </div>

                {/* Photo Target Panel */}
                <div
                  className="rounded-[20px] p-6 text-center space-y-2 border border-dashed border-[#D6DFCF]"
                  style={{ backgroundColor: DESIGN_TOKENS.colors.sagePanel }}
                >
                  <div className="w-10 h-10 rounded-full border-2 border-[#DE8B87] flex items-center justify-center mx-auto">
                    <div className="w-3.5 h-3.5 rounded-full bg-[#DE8B87]" />
                  </div>
                  <div>
                    <h4 className="text-[14px] font-bold text-[#474747]">
                      {t.whatToCook.photoCard.title}
                    </h4>
                    <p className="text-[11.5px] text-[#474747]/70 mt-0.5">
                      {t.whatToCook.photoCard.desc}
                    </p>
                  </div>
                </div>
              </div>

              {/* Leftovers Banner */}
              <div
                className="rounded-[24px] p-3.5 flex items-center justify-between shadow-xs cursor-pointer"
                style={{ backgroundColor: DESIGN_TOKENS.colors.sagePanel }}
              >
                <div className="pr-3">
                  <h4 className="text-[13.5px] font-bold text-[#474747]">
                    {t.whatToCook.leftoversCard.title}
                  </h4>
                  <p className="text-[11px] text-[#474747]/70 mt-0.5">
                    {t.whatToCook.leftoversCard.desc}
                  </p>
                </div>
                <div className="w-14 h-14 rounded-[16px] overflow-hidden shrink-0 shadow-2xs">
                  <img
                    src="https://images.unsplash.com/photo-1543339308-43e59d6b73a6?auto=format&fit=crop&w=200&q=80"
                    alt="Leftovers dish"
                    className="w-full h-full object-cover"
                  />
                </div>
              </div>

              {/* Quick Preferences */}
              <div className="space-y-2">
                <p className="text-[12px] font-semibold text-[#474747]/80">
                  {t.whatToCook.quickPreferences}
                </p>
                <div className="flex flex-wrap gap-2">
                  {[
                    { key: 'protein', label: t.whatToCook.tags.protein },
                    { key: 'upTo15', label: t.whatToCook.tags.upTo15 },
                    { key: 'dairyFree', label: t.whatToCook.tags.dairyFree },
                  ].map(({ key, label }) => {
                    const isSelected = wtcQuickPrefs.includes(key);
                    return (
                      <button
                        key={key}
                        type="button"
                        onClick={() => toggleWtcPref(key)}
                        className={`px-4 py-2 rounded-full text-[12.5px] font-medium transition-all ${
                          isSelected
                            ? 'border border-[#E58B91] shadow-2xs'
                            : 'border border-[#E8DFC9] bg-white'
                        }`}
                        style={{
                          backgroundColor: isSelected
                            ? DESIGN_TOKENS.colors.softPinkCard
                            : DESIGN_TOKENS.colors.white,
                          color: DESIGN_TOKENS.colors.text,
                        }}
                      >
                        {label}
                      </button>
                    );
                  })}
                </div>
              </div>
            </div>

            <footer className="pt-5 pb-2 text-center space-y-2">
              <Button variant="primary">
                {t.whatToCook.nextBtn}
              </Button>
              <p className="text-[11px] text-[#474747]/60">
                {t.whatToCook.footnote}
              </p>
            </footer>
          </div>
        )}

        {/* SCREEN 8: FIT MY MACROS */}
        {currentScreen === 'fitMacros' && (
          <div key="fitMacros" className="flex-1 flex flex-col justify-between">
            <div className="w-full text-left space-y-5">
              <TopNavBar
                title={t.nav.fitMacrosTitle}
                lang={lang}
                onBack={() => navigateTo('today')}
                onHome={() => navigateTo('today')}
                onToggleLang={toggleLanguage}
              />

              <div className="space-y-1.5">
                <h1
                  className="text-[34px] font-bold leading-[1.12] tracking-tight"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.serif,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.fitMacros.headline}
                </h1>
                <p className="text-[13.5px] opacity-75 leading-relaxed">
                  {t.fitMacros.subtitle}
                </p>
              </div>

              {/* 2 Target Options */}
              <div className="space-y-3 pt-2">
                <div
                  onClick={() => setMacroChoice('yes')}
                  className={`rounded-[24px] p-4 flex items-start gap-3 cursor-pointer transition-all border ${
                    macroChoice === 'yes'
                      ? 'border-[#C2D6B8] shadow-xs'
                      : 'border-[#ECE2D2] bg-white'
                  }`}
                  style={{
                    backgroundColor:
                      macroChoice === 'yes'
                        ? DESIGN_TOKENS.colors.sagePanel
                        : DESIGN_TOKENS.colors.white,
                  }}
                >
                  <span className="text-[15px] text-[#474747] font-bold mt-0.5">✓</span>
                  <div>
                    <h4 className="text-[14px] font-bold text-[#474747]">
                      {t.fitMacros.option1.title}
                    </h4>
                    <p className="text-[12px] text-[#474747]/70 mt-0.5">
                      {t.fitMacros.option1.desc}
                    </p>
                  </div>
                </div>

                <div
                  onClick={() => setMacroChoice('no')}
                  className={`rounded-[24px] p-4 flex items-start gap-3 cursor-pointer transition-all border ${
                    macroChoice === 'no'
                      ? 'border-[#E58B91] shadow-xs bg-[#FFF]'
                      : 'border-[#ECE2D2] bg-white'
                  }`}
                  style={{
                    backgroundColor:
                      macroChoice === 'no'
                        ? DESIGN_TOKENS.colors.softPinkCard
                        : DESIGN_TOKENS.colors.white,
                  }}
                >
                  <span className="text-[14px] text-[#474747] mt-0.5">✦</span>
                  <div>
                    <h4 className="text-[14px] font-bold text-[#474747]">
                      {t.fitMacros.option2.title}
                    </h4>
                    <p className="text-[12px] text-[#474747]/70 mt-0.5">
                      {t.fitMacros.option2.desc}
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <footer className="pt-6 pb-2">
              <Button variant="primary" onClick={() => navigateTo('today')}>
                {t.fitMacros.continueBtn}
              </Button>
            </footer>
          </div>
        )}

        {/* SCREEN 9: I WANT DESSERT */}
        {currentScreen === 'dessert' && (
          <div key="dessert" className="flex-1 flex flex-col justify-between">
            <div className="w-full text-left space-y-4">
              <TopNavBar
                title={t.nav.dessertTitle}
                lang={lang}
                onBack={() => navigateTo('today')}
                onHome={() => navigateTo('today')}
                onToggleLang={toggleLanguage}
              />

              <div className="space-y-1">
                <h1
                  className="text-[34px] font-bold leading-[1.12] tracking-tight"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.serif,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.dessert.headline}
                </h1>
                <p className="text-[13.5px] opacity-75">
                  {t.dessert.subtitle}
                </p>
              </div>

              {/* Dessert Hero Image */}
              <div className="relative w-full aspect-[16/9] rounded-[28px] overflow-hidden shadow-xs">
                <img
                  src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=800&q=80"
                  alt="Dessert preview"
                  className="w-full h-full object-cover"
                />
                <div className="absolute inset-0 flex items-center justify-center gap-3">
                  <span className="text-3xl drop-shadow-md">🍫</span>
                  <span className="text-3xl drop-shadow-md">🍓</span>
                </div>
              </div>

              {/* Dessert Tags */}
              <div className="grid grid-cols-3 gap-2 pt-1">
                {[
                  { key: 'chocolate', label: t.dessert.tags.chocolate },
                  { key: 'withBerries', label: t.dessert.tags.withBerries },
                  { key: 'sugarFree', label: t.dessert.tags.sugarFree },
                  { key: 'dairyFree', label: t.dessert.tags.dairyFree },
                  { key: 'highProtein', label: t.dessert.tags.highProtein },
                  { key: 'upTo250', label: t.dessert.tags.upTo250 },
                ].map(({ key, label }) => {
                  const isSelected = dessertTags.includes(key);
                  return (
                    <button
                      key={key}
                      type="button"
                      onClick={() => toggleDessertTag(key)}
                      className={`min-h-[42px] px-2 py-2 rounded-[18px] text-[12px] font-medium transition-all ${
                        isSelected
                          ? 'border border-[#E58B91] shadow-2xs'
                          : 'border border-[#E8DFC9] bg-white'
                      }`}
                      style={{
                        backgroundColor: isSelected
                          ? DESIGN_TOKENS.colors.softPinkCard
                          : DESIGN_TOKENS.colors.white,
                        color: DESIGN_TOKENS.colors.text,
                      }}
                    >
                      {label}
                    </button>
                  );
                })}
              </div>
            </div>

            <footer className="pt-6 pb-2">
              <Button variant="primary" onClick={() => navigateTo('today')}>
                {t.dessert.showBtn}
              </Button>
            </footer>
          </div>
        )}

        {/* SCREEN 10: SURPRISE ME */}
        {currentScreen === 'surprise' && (
          <div key="surprise" className="flex-1 flex flex-col justify-between">
            <div className="w-full text-left space-y-5">
              <TopNavBar
                title={t.nav.surpriseTitle}
                lang={lang}
                onBack={() => navigateTo('today')}
                onHome={() => navigateTo('today')}
                onToggleLang={toggleLanguage}
              />

              <div className="space-y-1.5">
                <h1
                  className="text-[34px] font-bold leading-[1.12] tracking-tight"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.serif,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.surprise.headline}
                </h1>
                <p className="text-[13.5px] opacity-75 leading-relaxed">
                  {t.surprise.subtitle}
                </p>
              </div>

              {/* Mood List */}
              <div className="space-y-3 pt-2">
                {t.surprise.options.map((option, idx) => {
                  const isSelected = moodIndex === idx;
                  return (
                    <div
                      key={option}
                      onClick={() => setMoodIndex(idx)}
                      className={`w-full min-h-[54px] px-5 py-3.5 rounded-[22px] flex items-center justify-start text-[14px] font-medium cursor-pointer transition-all border ${
                        isSelected
                          ? 'border-[#E58B91] shadow-xs'
                          : 'border-[#ECE2D2] bg-white'
                      }`}
                      style={{
                        backgroundColor: isSelected
                          ? DESIGN_TOKENS.colors.softPinkCard
                          : DESIGN_TOKENS.colors.white,
                        color: DESIGN_TOKENS.colors.text,
                      }}
                    >
                      {option}
                    </div>
                  );
                })}
              </div>
            </div>

            <footer className="pt-6 pb-2">
              <Button variant="primary" onClick={() => navigateTo('today')}>
                {t.surprise.surpriseBtn}
              </Button>
            </footer>
          </div>
        )}

        {/* SCREEN 11: EVERYDAY MEALS */}
        {currentScreen === 'everydayMeals' && (
          <div key="everydayMeals" className="flex-1 flex flex-col justify-between">
            <div className="w-full text-left space-y-5">
              <TopNavBar
                title={t.nav.everydayMealsTitle}
                lang={lang}
                onBack={() => navigateTo('today')}
                onHome={() => navigateTo('today')}
                onToggleLang={toggleLanguage}
              />

              <div className="space-y-1.5">
                <h1
                  className="text-[34px] font-bold leading-[1.12] tracking-tight"
                  style={{
                    fontFamily: DESIGN_TOKENS.typography.serif,
                    color: DESIGN_TOKENS.colors.text,
                  }}
                >
                  {t.everydayMeals.headline}
                </h1>
                <p className="text-[13.5px] opacity-75 leading-relaxed">
                  {t.everydayMeals.subtitle}
                </p>
              </div>

              {/* Meal Pills */}
              <div className="flex flex-wrap gap-2">
                {(['breakfast', 'lunch', 'dinner', 'snack'] as const).map((meal) => {
                  const isSelected = mealType === meal;
                  return (
                    <button
                      key={meal}
                      type="button"
                      onClick={() => setMealType(meal)}
                      className={`px-4 py-2 rounded-full text-[13px] font-medium transition-all ${
                        isSelected
                          ? 'border border-[#E58B91] shadow-2xs'
                          : 'border border-[#E8DFC9] bg-white'
                      }`}
                      style={{
                        backgroundColor: isSelected
                          ? DESIGN_TOKENS.colors.softPinkCard
                          : DESIGN_TOKENS.colors.white,
                        color: DESIGN_TOKENS.colors.text,
                      }}
                    >
                      {t.everydayMeals.meals[meal]}
                    </button>
                  );
                })}
              </div>

              {/* Filters */}
              <div className="space-y-3 pt-1">
                {[
                  { key: 'balanced', label: t.everydayMeals.filters.balanced },
                  { key: 'quick', label: t.everydayMeals.filters.quick },
                  { key: 'family', label: t.everydayMeals.filters.family },
                ].map(({ key, label }) => {
                  const isSelected = selectedFilters.includes(key);
                  return (
                    <div
                      key={key}
                      onClick={() => toggleMealFilter(key)}
                      className={`w-full min-h-[52px] px-5 py-3 rounded-[22px] flex items-center justify-start text-[14px] font-medium cursor-pointer transition-all border ${
                        isSelected
                          ? 'border-[#E58B91] shadow-xs'
                          : 'border-[#ECE2D2] bg-white'
                      }`}
                      style={{
                        backgroundColor: isSelected
                          ? DESIGN_TOKENS.colors.softPinkCard
                          : DESIGN_TOKENS.colors.white,
                        color: DESIGN_TOKENS.colors.text,
                      }}
                    >
                      {label}
                    </div>
                  );
                })}
              </div>
            </div>

            <footer className="pt-6 pb-2">
              <Button variant="primary" onClick={() => navigateTo('today')}>
                {t.everydayMeals.showBtn}
              </Button>
            </footer>
          </div>
        )}
      </main>

      {/* Styled Popup Dialog */}
      <ThemedPopup
        isOpen={popup.isOpen}
        isError={popup.isError}
        title={popup.title}
        message={popup.message}
        primaryButtonText={popup.primaryBtn}
        onPrimaryClick={popup.onPrimary}
        secondaryButtonText={popup.secondaryBtn}
        onSecondaryClick={popup.onSecondary}
      />
    </div>
  );
}
