import React, { useState } from 'react';

// Design tokens
const DESIGN_TOKENS = {
  colors: {
    background: '#FFF9F2',
    primaryButton: '#E58B91',
    accent: '#DE8B87',
    text: '#474747',
  },
  typography: {
    serif: "'Playfair Display', Georgia, Cambria, 'Times New Roman', serif",
    sans: "'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
  },
} as const;

type SupportedLanguage = 'en' | 'ru';

// Bilingual translations
const translations = {
  en: {
    topHeader: 'What should we cook today? ♡',
    headline: 'What should we cook\ntoday?',
    subtitle: 'Don’t plan your whole life.\nJust decide what to cook today.',
    russianBtn: 'Russian',
    englishBtn: 'English',
    imageAlt: 'Healthy grain bowl with sliced grilled chicken breast, quinoa, avocado, and vegetables',
    badge: '1/3',
  },
  ru: {
    topHeader: 'Что приготовить сегодня? ♡',
    headline: 'Что приготовить\nсегодня?',
    subtitle: 'Не планируйте всю жизнь.\nПросто решите, что приготовить сегодня.',
    russianBtn: 'Русский',
    englishBtn: 'English',
    imageAlt: 'Полезное блюдо с куриной грудкой, киноа, авокадо и овощами',
    badge: '1/3',
  },
} as const;

export default function App() {
  const [lang, setLang] = useState<SupportedLanguage>('en');
  const t = translations[lang];

  return (
    <div
      className="min-h-screen w-full flex justify-center items-center px-4 py-8 select-none"
      style={{
        backgroundColor: DESIGN_TOKENS.colors.background,
        color: DESIGN_TOKENS.colors.text,
        fontFamily: DESIGN_TOKENS.typography.sans,
      }}
    >
      {/* Centered content column (mobile-sized card container without phone borders) */}
      <main className="w-full max-w-[390px] min-h-[760px] flex flex-col justify-between mx-auto">
        {/* Top Header */}
        <header className="pt-2 pb-2 text-center">
          <p
            className="text-[14px] font-medium tracking-wide"
            style={{
              color: DESIGN_TOKENS.colors.accent,
              fontFamily: DESIGN_TOKENS.typography.sans,
            }}
          >
            {t.topHeader}
          </p>
        </header>

        {/* Hero Image & Headline Area */}
        <section className="flex-1 flex flex-col justify-center my-auto space-y-6">
          {/* Meal Photo */}
          <div className="relative w-full aspect-[1/0.92] rounded-[32px] overflow-hidden shadow-[0_8px_24px_rgba(0,0,0,0.06)]">
            <img
              src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80"
              alt={t.imageAlt}
              className="w-full h-full object-cover"
            />
            <span className="absolute bottom-3 right-3 bg-black/45 backdrop-blur-sm text-white text-[11px] font-medium px-2.5 py-1 rounded-full tracking-wider">
              {t.badge}
            </span>
          </div>

          {/* Typography */}
          <div className="space-y-3 px-1">
            <h1
              className="text-[38px] leading-[1.12] font-bold tracking-tight whitespace-pre-line"
              style={{
                fontFamily: DESIGN_TOKENS.typography.serif,
                color: DESIGN_TOKENS.colors.text,
              }}
            >
              {t.headline}
            </h1>
            <p
              className="text-[15px] leading-relaxed whitespace-pre-line opacity-85"
              style={{
                fontFamily: DESIGN_TOKENS.typography.sans,
                color: DESIGN_TOKENS.colors.text,
              }}
            >
              {t.subtitle}
            </p>
          </div>
        </section>

        {/* Language Selection Buttons */}
        <footer className="pt-4 pb-2">
          <div className="grid grid-cols-2 gap-3.5">
            <button
              type="button"
              onClick={() => setLang('ru')}
              aria-label="Switch language to Russian"
              className="min-h-[48px] px-5 py-2.5 rounded-2xl text-[15px] font-medium transition-all duration-200 outline-none flex items-center justify-center text-center shadow-sm active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-offset-2"
              style={{
                backgroundColor:
                  lang === 'ru'
                    ? DESIGN_TOKENS.colors.primaryButton
                    : '#FFFFFF',
                color:
                  lang === 'ru'
                    ? '#FFFFFF'
                    : DESIGN_TOKENS.colors.text,
              }}
            >
              {t.russianBtn}
            </button>

            <button
              type="button"
              onClick={() => setLang('en')}
              aria-label="Switch language to English"
              className="min-h-[48px] px-5 py-2.5 rounded-2xl text-[15px] font-medium transition-all duration-200 outline-none flex items-center justify-center text-center shadow-sm active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-offset-2"
              style={{
                backgroundColor:
                  lang === 'en'
                    ? DESIGN_TOKENS.colors.primaryButton
                    : '#FFFFFF',
                color:
                  lang === 'en'
                    ? '#FFFFFF'
                    : DESIGN_TOKENS.colors.text,
              }}
            >
              {t.englishBtn}
            </button>
          </div>
        </footer>
      </main>
    </div>
  );
}
